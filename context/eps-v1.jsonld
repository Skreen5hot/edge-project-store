{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://skreen5hot.github.io/edge-project-store/ns#",
    "eps": "https://skreen5hot.github.io/edge-project-store/ns#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",

    "EdgeProject": "eps:EdgeProject",
    "ArtifactRecord": "eps:ArtifactRecord",
    "StageRevision": "eps:StageRevision",
    "ProjectReport": "eps:ProjectReport",

    "added": { "@id": "eps:added", "@container": "@set" },
    "artifacts": { "@id": "eps:artifacts", "@container": "@list" },
    "bytes": { "@id": "eps:bytes", "@type": "xsd:integer" },
    "code": "eps:code",
    "collection": "eps:collection",
    "contractVersion": { "@id": "eps:contractVersion", "@type": "xsd:integer" },
    "createdAt": { "@id": "eps:createdAt", "@type": "xsd:dateTime" },
    "current": { "@id": "eps:current", "@container": "@set" },
    "diagnostics": { "@id": "eps:diagnostics", "@container": "@list" },
    "generation": "eps:generation",
    "heads": { "@id": "eps:heads", "@container": "@set" },
    "historyBecause": { "@id": "eps:historyBecause", "@container": "@list" },
    "historyVerified": { "@id": "eps:historyVerified", "@type": "xsd:boolean" },
    "inStageCurrent": { "@id": "eps:inStageCurrent", "@type": "xsd:boolean" },
    "input": "eps:input",
    "inputs": { "@id": "eps:inputs", "@container": "@set" },
    "kind": "eps:kind",
    "members": { "@id": "eps:members", "@container": "@set" },
    "name": "eps:name",
    "notReadyBecause": { "@id": "eps:notReadyBecause", "@container": "@list" },
    "parents": { "@id": "eps:parents", "@container": "@set" },
    "path": "eps:path",
    "pipelineReady": { "@id": "eps:pipelineReady", "@type": "xsd:boolean" },
    "producedBy": "eps:producedBy",
    "project": { "@id": "eps:project", "@type": "@id" },
    "relation": "eps:relation",
    "removed": { "@id": "eps:removed", "@container": "@set" },
    "responsibility": "eps:responsibility",
    "role": "eps:role",
    "sha256": "eps:sha256",
    "stage": "eps:stage",
    "stages": "eps:stages",
    "staleBecause": { "@id": "eps:staleBecause", "@container": "@list" },
    "status": "eps:status",
    "tool": "eps:tool",
    "upToDate": { "@id": "eps:upToDate", "@type": "xsd:boolean" },
    "valid": { "@id": "eps:valid", "@type": "xsd:boolean" },
    "version": "eps:version"
  }
}
