{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skreen5hot.github.io/edge-project-store/schemas/project-report-v2.schema.json",
  "title": "edge-project-store ProjectReport, contract version 2",
  "description": "Shape of the report the contract's evaluation produces for a project folder (EPS §7). It is an output of the module, never a file in a project. A null upToDate, historyVerified or inStageCurrent means the value could not be evaluated because a file could not be read (E-UNREADABLE). Property order is the canonical key order (R-B1).",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "contractVersion",
    "project",
    "valid",
    "stages",
    "artifacts",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "$ref": "#/$defs/context"
    },
    "@type": {
      "const": "ProjectReport"
    },
    "contractVersion": {
      "const": 2
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/stageReport"
        },
        "normalized": {
          "$ref": "#/$defs/stageReport"
        },
        "sdd": {
          "$ref": "#/$defs/stageReport"
        },
        "rml": {
          "$ref": "#/$defs/stageReport"
        },
        "rdf": {
          "$ref": "#/$defs/stageReport"
        },
        "graph": {
          "$ref": "#/$defs/stageReport"
        },
        "diagrams": {
          "$ref": "#/$defs/stageReport"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReport"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "context": {
      "const": "https://skreen5hot.github.io/edge-project-store/context/eps-v2.jsonld"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^(source|normalized|sdd|rml|rdf|graph|diagrams)/[a-z0-9][a-z0-9-]{0,39}-[0-9]{8}T[0-9]{6}Z-([0-9a-f]{8}|[0-9a-f]{16}|[0-9a-f]{32}|[0-9a-f]{64})\\.[a-z0-9]{1,10}$"
    },
    "member": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reason": {
      "type": "object",
      "required": [
        "code",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INPUT-MISSING",
            "INPUT-ALTERED",
            "INPUT-SUPERSEDED",
            "UPSTREAM-UNSETTLED",
            "UPSTREAM-OUT-OF-DATE",
            "SOURCE-CHANGED",
            "CYCLE",
            "INPUT-UNREADABLE",
            "UPSTREAM-UNEVALUABLE"
          ]
        },
        "input": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          }
        }
      }
    },
    "historyReason": {
      "type": "object",
      "required": [
        "code",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "HISTORY-MISSING",
            "HISTORY-ALTERED",
            "HISTORY-UNREADABLE"
          ]
        },
        "input": {
          "type": "string"
        }
      }
    },
    "stageReport": {
      "type": "object",
      "required": [
        "status",
        "heads",
        "current"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "empty",
            "ok",
            "out-of-date",
            "conflicted",
            "incomplete",
            "damaged",
            "unevaluable"
          ]
        },
        "heads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifactReport": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "stage",
        "inStageCurrent",
        "upToDate",
        "staleBecause",
        "historyVerified",
        "historyBecause"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage": {
          "enum": [
            "source",
            "normalized",
            "sdd",
            "rml",
            "rdf",
            "graph",
            "diagrams"
          ]
        },
        "inStageCurrent": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "upToDate": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "staleBecause": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "historyVerified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "historyBecause": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/historyReason"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[EW]-[A-Z0-9-]+$"
        },
        "path": {
          "type": "string"
        },
        "error": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        }
      }
    }
  }
}
