{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skreen5hot.github.io/edge-project-store/schemas/project-report-v1.schema.json",
  "title": "edge-project-store ProjectReport, contract version 1",
  "description": "Shape of the report the contract's evaluation produces for a project folder (EPS §7). It is an output of the module, never a file in a project. Property order is the canonical key order (R-B1).",
  "type": "object",
  "required": [
    "@context",
    "@type",
    "contractVersion",
    "project",
    "valid",
    "stages",
    "artifacts",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "@context": {
      "$ref": "#/$defs/context"
    },
    "@type": {
      "const": "ProjectReport"
    },
    "contractVersion": {
      "const": 1
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "valid": {
      "type": "boolean"
    },
    "stages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "$ref": "#/$defs/stageReport"
        },
        "normalized": {
          "$ref": "#/$defs/stageReport"
        },
        "sdd": {
          "$ref": "#/$defs/stageReport"
        },
        "rml": {
          "$ref": "#/$defs/stageReport"
        },
        "rdf": {
          "$ref": "#/$defs/stageReport"
        },
        "graph": {
          "$ref": "#/$defs/stageReport"
        },
        "diagrams": {
          "$ref": "#/$defs/stageReport"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifactReport"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "$defs": {
    "context": {
      "const": "https://skreen5hot.github.io/edge-project-store/context/eps-v1.jsonld"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "projectId": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$"
    },
    "artifactPath": {
      "type": "string",
      "pattern": "^(source|normalized|sdd|rml|rdf|graph|diagrams)/[a-z0-9][a-z0-9-]{0,39}-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}\\.[a-z0-9]{1,10}$"
    },
    "producedBy": {
      "type": "object",
      "required": [
        "responsibility",
        "tool",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "responsibility": {
          "enum": [
            "intake",
            "normalizer",
            "sdd-author",
            "rml-generator",
            "rdf-generator",
            "graph-loader",
            "diagram-exporter"
          ]
        },
        "tool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        }
      }
    },
    "artifactRef": {
      "type": "object",
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "reason": {
      "type": "object",
      "required": [
        "code",
        "input"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INPUT-MISSING",
            "INPUT-SUPERSEDED",
            "UPSTREAM-UNSETTLED",
            "UPSTREAM-OUT-OF-DATE",
            "SOURCE-CHANGED",
            "CYCLE"
          ]
        },
        "input": {
          "type": "string"
        },
        "added": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "stageReport": {
      "type": "object",
      "required": [
        "status",
        "heads",
        "current"
      ],
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "empty",
            "ok",
            "out-of-date",
            "conflicted",
            "incomplete",
            "damaged"
          ]
        },
        "heads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifactReport": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "stage",
        "inStageCurrent",
        "upToDate",
        "staleBecause",
        "pipelineReady",
        "notReadyBecause"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/artifactPath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stage": {
          "enum": [
            "source",
            "normalized",
            "sdd",
            "rml",
            "rdf",
            "graph",
            "diagrams"
          ]
        },
        "inStageCurrent": {
          "type": "boolean"
        },
        "upToDate": {
          "type": "boolean"
        },
        "staleBecause": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reason"
          }
        },
        "pipelineReady": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "notReadyBecause": {
          "type": "array",
          "items": {
            "enum": [
              "OUT-OF-DATE",
              "NOT-CURRENT",
              "NO-STRUCTURAL-ROOT",
              "STRUCTURAL-ROOT-MISMATCH"
            ]
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "code",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "path": {
          "type": "string"
        }
      }
    }
  }
}
